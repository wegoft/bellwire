{
  "name": "bellwire",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:auth": "wrangler dev -c wrangler.auth.toml",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:worker": "vitest run --exclude test/ios-preview.test.js",
    "test:ios": "vitest run test/ios-preview.test.js",
    "test:watch": "vitest",
    "test:live": "node scripts/live-smoke.mjs",
    "self-host:bootstrap": "node scripts/self-host-bootstrap.mjs",
    "self-host:doctor": "node scripts/self-host-doctor.mjs",
    "self-host:apns-preflight": "node scripts/apns-preflight.mjs",
    "migration:prepare": "node scripts/prepare-cloudflare-migration.mjs",
    "build": "wrangler deploy --dry-run --outdir dist && wrangler deploy --dry-run --outdir dist-auth -c wrangler.auth.toml",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply AUTH_DB --local -c wrangler.auth.toml",
    "ios:build": "xcodebuild -project ios/Bellwire/Bellwire.xcodeproj -scheme Bellwire -sdk iphonesimulator -configuration Debug CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "better-auth": "1.6.26",
    "hono": "^4.13.1",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@eslint/js": "^9.31.0",
    "better-call": "^1.3.7",
    "eslint": "^9.31.0",
    "globals": "^17.7.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.25.0"
  },
  "engines": {
    "node": ">=22"
  }
}
